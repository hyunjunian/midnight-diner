{
  "name": "midnight-diner",
  "version": "1.0.0",
  "private": true,
  "description": "심야식탁: 정적 웹 게임(docs/)과 Capacitor iOS/Android 앱",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:native": "node tools/build-native.cjs",
    "sync": "node tools/build-native.cjs && cap sync",
    "sync:ios": "node tools/build-native.cjs && cap sync ios",
    "sync:android": "node tools/build-native.cjs && cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "pretest": "node tools/set-release.cjs",
    "build:web": "node tools/build-web.cjs",
    "deploy:web": "node tools/build-web.cjs && wrangler deploy",
    "deploy:update": "node tools/publish-update.cjs --deploy",
    "test:browser": "node tools/test-browser.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capgo/capacitor-updater": "^8.54.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.35.5"
  },
  "liveUpdate": {
    "minNative": "1.0"
  }
}
