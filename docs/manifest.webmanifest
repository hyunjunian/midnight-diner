{
  "id": "./",
  "name": "심야식당",
  "short_name": "심야식당",
  "description": "골목 끝 작은 식당의 주인이 되는 요리와 이야기 게임",
  "lang": "ko",
  "start_url": "./?launch=pwa",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#111d20",
  "categories": [
    "games",
    "entertainment"
  ],
  "icons": [
    {
      "src": "./assets/icon-diner-v31-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-diner-v31-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-diner-v31-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "screenshots": [
    {
      "src": "./assets/pwa-shot-service-v64.png",
      "sizes": "786x1704",
