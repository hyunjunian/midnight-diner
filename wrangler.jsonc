// Browser test site. `npx wrangler deploy` runs the build below first: it copies docs/ to
// dist/web and tags the release, so no separate build command is needed in the dashboard.
{
  "name": "midnight",
  "compatibility_date": "2026-11-04",
  "build": {
    "command": "node tools/build-web.cjs"
  },
  "assets": {
    "directory": "./dist/web"
  },
  // Served only at the custom domain; keep the workers.dev and preview addresses off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "midnight.couprice.com", "custom_domain": true }
  ]
}
