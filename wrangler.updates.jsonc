// Live-update host for the native apps: serves the app bundle and latest.json as
// free static assets. Deploy with: node tools/publish-update.cjs --deploy
// (The browser test site keeps using wrangler.jsonc.)
{
  "name": "midnight-diner-updates",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist/live-update/site",
    // Serve every file at its exact path: no /index.html -> / redirects.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "midnight-update.couprice.com", "custom_domain": true }
  ]
}
